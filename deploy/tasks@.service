# Taskz on one port; %i is the port (8081 or 8082). deploy/release.sh starts the new release on
# the free one and then stops the other. Setup: deploy/README.md.
[Unit]
Description=Taskz on port %i

[Service]
# Only nginx on this machine talks to the app.
Environment=SERVER_ADDRESS=127.0.0.1
WorkingDirectory=%h
# Settings (database, OAuth, mail) in tasks.properties, the same for both ports; the port from the
# command line wins over a server.port there.
ExecStart=/usr/bin/java -jar %h/tasks/tasks-%i.jar --spring.config.location=file:%h/tasks/tasks.properties --server.port=%i
# A JVM stopped with SIGTERM exits with 143; that is a normal stop, not a failure.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
